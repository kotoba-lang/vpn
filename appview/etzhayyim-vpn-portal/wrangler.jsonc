{
  "name": "etzhayyim-project-vpn",
  "main": "src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "vpn.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "vars": {
    "VPN_VERSION": "0.1.0-beta",
    "VPN_ACTOR_DID": "did:web:vpn.etzhayyim.com"
  },
  "observability": {
    "enabled": true
  }
  // secrets (wrangler secret put). All three are required: src/app.ts answers
  // 503 rather than calling the provisioner without an address or a credential.
  //   VPN_PROVISIONER_URL  — https://<provisioner-tunnel-hostname>
  //                          Cloudflare Tunnel, not the LoadBalancer IP this
  //                          comment used to give (ADR-2608123400); that LB was
  //                          deleted with the cluster (ADR-2606120930).
  //   PROVISIONER_SECRET   — shared secret for x-internal-trust header
  //   AUTHN_SERVICE_URL    — https://auth.etzhayyim.com (or service binding)
}
